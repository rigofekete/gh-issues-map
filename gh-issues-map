#!/usr/bin/env bash
# gh-issues-map — render this repo's GitHub Issues as a PRD-grouped dependency map.
# Usage: gh issues-map [--flat]
set -euo pipefail

FLAT=0
for arg in "$@"; do
  case "$arg" in
    --flat) FLAT=1 ;;
    -h|--help)
      cat <<'EOF'
gh-issues-map — dependency map of this repo's GitHub Issues, grouped by PRD.

Usage:
  gh issues-map [--flat]

  --flat   Print one flat table sorted by issue number (the original view).
  -h       Show this help.

By default each PRD is rendered in ascending number order: an issue that has
sub-issues, carries the `spec` label, or whose title starts with "PRD:". A PRD
header shows progress, then its child issues in ascending order. Fully closed
PRDs are rendered in full with a muted "finished" palette. Parentless non-PRD
issues appear under "Unassigned", and the "Workable now" frontier is grouped
the same way.
EOF
      exit 0 ;;
    "") ;;
    *) echo "gh issues-map: unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Colorize a plain `column -t` table read on stdin. $1 is 1 for a "finished"
# (fully closed) group, which selects a muted palette.
colorize_table() {
  local fin="${1:-0}"
  if [ ! -t 1 ] || [ -n "${NO_COLOR-}" ]; then
    cat
    return
  fi

  awk -v esc="$(printf '\033')" -v marker="$(printf '\034')" -v fin="$fin" '
    function color(code, text) { return esc "[" code "m" text reset }
    BEGIN {
      if (fin == 1) {
        base = "38;2;118;122;132"; hdr = "1;38;2;120;130;150"
        openc = "38;2;150;130;95"; closedc = "38;2;95;135;110"
        refc = "38;2;150;110;120"; frontc = "1;38;2;95;135;110"
        reset = esc "[0;38;2;118;122;132m"
      } else {
        base = "38;2;211;208;216"; hdr = "1;38;2;92;150;230"
        openc = "38;2;217;149;62"; closedc = "38;2;108;190;125"
        refc = "38;2;198;94;108"; frontc = "1;38;2;108;190;125"
        reset = esc "[0;38;2;211;208;216m"
      }
      base_seq = esc "[" base "m"
    }
    NR == 1 { print esc "[" hdr "m" $0 esc "[0m"; next }
    {
      if (match($0, /◀ FRONTIER[[:space:]]+/))
        $0 = substr($0, 1, RSTART + RLENGTH - 1) marker substr($0, RSTART + RLENGTH)
      sub(/OPEN/, color(openc, "OPEN"))
      sub(/CLOSED/, color(closedc, "CLOSED"))
      gsub(/#[0-9]+/, color(refc, "&"))
      sub(/—/, color(refc, "—"))
      sub(/◀ FRONTIER/, color(frontc, "◀ FRONTIER"))
      if (match($0, /waiting \([^)]*\)/)) {
        waiting = substr($0, RSTART, RLENGTH)
        sub(/waiting \([^)]*\)/, color(openc, waiting))
      }
      sub(/done ✓/, color(closedc, "done ✓"))
      if (match($0, marker)) {
        title = substr($0, RSTART + 1)
        $0 = substr($0, 1, RSTART - 1) color(hdr, title)
      }
      print base_seq $0 esc "[0m"
    }
  '
}

print_color() {
  if [ ! -t 1 ] || [ -n "${NO_COLOR-}" ]; then
    printf '%s\n' "$2"
  else
    printf '\033[%sm%s\033[0m\n' "$1" "$2"
  fi
}

# Render rows ("#|state|blocked by|status|title") as an indented table.
render_table() {
  local fin="$1"; shift
  if [ "$#" -eq 0 ]; then
    printf '  (no issues)\n'
    return
  fi
  {
    printf '%s\n' '#|state|blocked by|status|title'
    printf '%s\n' '-|-|-|-|-'
    printf '%s\n' "$@"
  } | column -t -s '|' | sed 's/^/  /' | colorize_table "$fin"
}

repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner')

# Fetch issue data and dependencies together instead of making requests per issue.
raw=$(gh issue list --state all --limit 500 --json number,title,state,blockedBy,parent,subIssuesSummary,labels \
  --jq '.[] | [
    (.number | tostring),
    .state,
    .title,
    ([.blockedBy.nodes[] | if .state == "OPEN" then "#\(.number)" else "#\(.number)✓" end] | join(", ")),
    ([.blockedBy.nodes[] | select(.state == "OPEN") | (.number | tostring)] | join(", #")),
    (.blockedBy.totalCount | tostring),
    (.parent.number // "" | tostring),
    (.subIssuesSummary.total | tostring),
    (.subIssuesSummary.completed | tostring),
    ([.labels[].name] | join(","))
  ] | join("\u001f")')

[ -z "$raw" ] && { echo "no issues in $repo"; exit 0; }

declare -A STATE TITLE BLOCKERS PARENT SUBTOTAL SUBDONE MARK CHILDREN FROWS LABELS
PRD_ORDER=()
UNASSIGNED=()
all=()

while IFS=$'\x1f' read -r n state title blockers open_blockers blocker_count parent sub_total sub_done labels; do
  [ -z "$n" ] && continue

  # gh issue list includes at most 50 blocker nodes per issue.
  if [ "$blocker_count" -gt 50 ]; then
    fallback=$(gh api --paginate --slurp \
      "repos/$repo/issues/$n/dependencies/blocked_by?per_page=100" \
      --jq '[
        ([.[][] | if .state == "open" then "#\(.number)" else "#\(.number)✓" end] | join(", ")),
        ([.[][] | select(.state == "open") | (.number | tostring)] | join(", #"))
      ] | join("\u001f")')
    IFS=$'\x1f' read -r blockers open_blockers <<< "$fallback"
  fi

  STATE[$n]=$state
  TITLE[$n]=$title
  BLOCKERS[$n]=${blockers:-—}
  PARENT[$n]=$parent
  SUBTOTAL[$n]=$sub_total
  SUBDONE[$n]=$sub_done
  LABELS[$n]=$labels
  if [ -n "$parent" ]; then CHILDREN[$parent]+="$n "; fi

  if [ "$state" = "OPEN" ]; then
    if [ -z "$open_blockers" ]; then
      MARK[$n]="◀ FRONTIER"
    else
      MARK[$n]="waiting (#$open_blockers)"
    fi
  else
    MARK[$n]="done ✓"
  fi

  all+=("$n")
done <<< "$raw"

row_for() { printf '%s|%s|%s|%s|%s' "$1" "${STATE[$1]}" "${BLOCKERS[$1]}" "${MARK[$1]}" "${TITLE[$1]}"; }
is_prd() {
  [ "${SUBTOTAL[$1]:-0}" -gt 0 ] && return 0
  [[ "${TITLE[$1]}" == PRD:* ]] && return 0
  [[ ",${LABELS[$1]:-}," == *,spec,* ]] && return 0
  return 1
}
note_frontier() { if [ "${MARK[$1]}" = "◀ FRONTIER" ]; then FROWS[$2]+="#$1 ${TITLE[$1]}"$'\n'; fi; }

all_sorted=$(printf '%s\n' "${all[@]}" | sort -n)

# --- flat mode: original single table -------------------------------------
if [ "$FLAT" = 1 ]; then
  echo "repo: $repo"
  echo
  rows=()
  while IFS= read -r n; do
    [ -n "$n" ] && rows+=("$(row_for "$n")")
  done <<< "$all_sorted"
  render_table 0 "${rows[@]}"
  echo
  print_color '1;38;2;92;150;230' 'Workable now'
  found=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ "${MARK[$n]}" = "◀ FRONTIER" ]; then
      print_color '38;2;211;208;216' "  #$n ${TITLE[$n]}"
      found=1
    fi
  done <<< "$all_sorted"
  [ "$found" = 0 ] && echo "  Frontier empty — everything blocked or done."
  exit 0
fi

# --- grouped mode ----------------------------------------------------------
for n in $all_sorted; do
  if [ -z "${PARENT[$n]}" ]; then
    if is_prd "$n"; then PRD_ORDER+=("$n"); else UNASSIGNED+=("$n"); fi
  fi
done
# Orphans whose parent is missing from the repo.
for n in "${all[@]}"; do
  p="${PARENT[$n]}"
  if [ -n "$p" ] && [ -z "${TITLE[$p]:-}" ]; then UNASSIGNED+=("$n"); fi
done

echo "repo: $repo"
echo

for t in "${PRD_ORDER[@]}"; do
  total=${SUBTOTAL[$t]}
  done_count=${SUBDONE[$t]}
  fin=0
  if [ "$total" -gt 0 ] && [ "$done_count" -eq "$total" ]; then fin=1; fi

  header="PRD: ${TITLE[$t]#PRD: }   (#$t)"
  if [ "$total" -gt 0 ]; then
    header+="   $done_count/$total done"
  else
    header+="   ⚠ no linked children"
  fi
  if [ "$fin" = 1 ]; then
    print_color '1;38;2;120;130;150' "$header"
  else
    print_color '1;38;2;92;150;230' "$header"
  fi

  kid_list=$(printf '%s\n' ${CHILDREN[$t]:-} | grep -v '^$' | sort -n | tr '\n' ' ' || true)
  kids=()
  if [ -n "$kid_list" ]; then read -ra kids <<< "$kid_list"; fi
  rows=()
  for k in "${kids[@]}"; do
    rows+=("$(row_for "$k")")
    note_frontier "$k" "$t"
  done
  render_table "$fin" "${rows[@]}"
  echo
done

if [ "${#UNASSIGNED[@]}" -gt 0 ]; then
  print_color '1;38;2;217;149;62' 'Unassigned'
  un_sorted=$(printf '%s\n' "${UNASSIGNED[@]}" | sort -n)
  rows=()
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    rows+=("$(row_for "$n")")
    note_frontier "$n" 0
  done <<< "$un_sorted"
  render_table 0 "${rows[@]}"
  echo
fi

print_color '1;38;2;92;150;230' 'Workable now'
if [ "${#FROWS[@]}" -eq 0 ]; then
  echo "  Frontier empty — everything blocked or done."
else
  for t in "${PRD_ORDER[@]}"; do
    [ -n "${FROWS[$t]:-}" ] || continue
    print_color '38;2;150;160;180' "  PRD: ${TITLE[$t]#PRD: } (#$t)"
    while IFS= read -r line; do
      [ -n "$line" ] && print_color '38;2;211;208;216' "    $line"
    done <<< "${FROWS[$t]}"
  done
  if [ -n "${FROWS[0]:-}" ]; then
    print_color '38;2;150;160;180' '  Unassigned'
    while IFS= read -r line; do
      [ -n "$line" ] && print_color '38;2;211;208;216' "    $line"
    done <<< "${FROWS[0]}"
  fi
fi
